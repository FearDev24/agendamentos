# Bloqueia acesso direto via navegador aos Controllers, Models, Views e Helpers.
# O carregamento destes arquivos ocorre exclusivamente via require/autoload no index.php.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
