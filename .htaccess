# Apache Server Rewrite Rules - AgendaBarber Web

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sem RewriteBase fixo: o Apache resolve o prefixo pela pasta onde este
    # arquivo está. Assim as mesmas regras valem tanto em subpasta
    # (localhost/sistemaBarbearia) quanto na raiz de um VirtualHost.

    # Redireciona requisições de arquivos e diretórios existentes diretamente para public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Reescreve todas as outras rotas para o Front Controller index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Desativa a listagem pública de diretórios
Options -Indexes

# Cabeçalhos de segurança para arquivos servidos direto pelo Apache (imagens,
# CSS, JS), que não passam pelo index.php. As rotas da aplicação recebem estes
# e mais a Content-Security-Policy e o HSTS, definidos no index.php.
#
# O X-XSS-Protection foi removido: o filtro que ele acionava não existe mais
# nos navegadores atuais e, onde ainda existe, já causou vulnerabilidades.
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
